# Copy to .env if you want to override these local-demo defaults.
APP_PORT=8080
POSTGRES_PASSWORD=flashsale-local-only
RABBITMQ_PASSWORD=flashsale-local-only
# Fixed stock is 500. A past timestamp makes the demo immediately available.
# Set an ISO timestamp with timezone to demonstrate the countdown.
SALE_START=2026-10-28T00:00:00Z
WORKER_CONCURRENCY=4
WORKER_DELAY_MS=60
# Rate limit per demo customer per minute. This is not authentication.
RATE_LIMIT=60
